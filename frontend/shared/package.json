      "types": "./tokens/generated/tailwind-preset.d.ts",
      "default": "./tokens/generated/tailwind-preset.js"
    },
    "./api-types": "./src/api-types/openapi.gen.ts"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.5.46",
    "vue-i18n": "11.4.23"
  }
}
