{
  "name": "@lingedge/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "无权限语义的共享包：设计令牌、三态组件、格式化、i18n 工具、OpenAPI 生成类型（ADR-014 §1/§2）。",
  "exports": {
    ".": "./src/index.ts",
