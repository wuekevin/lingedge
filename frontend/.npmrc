# 依赖供应链硬化（Story 1.36 AC1、dev-environment §4）
# 关闭所有依赖的生命周期脚本（preinstall/install/postinstall）：未经审核的包不得在安装时执行代码。
# 需要脚本的包必须先在 README「生命周期脚本审核」登记并由 check-deps 放行后，才能改为白名单。
ignore-scripts=true
# 精确版本写入 package.json（再由 scripts/check-deps.mjs 在 CI 校验）。
save-exact=true
engine-strict=true
# 公共 registry；锁文件入库，CI 使用 pnpm install --frozen-lockfile。
registry=https://registry.npmjs.org/
