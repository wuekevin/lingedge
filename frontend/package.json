{
  "name": "lingedge-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LingEdge（凌界云）前端 pnpm workspace 根（ADR-014）：admin / console / website / shared。",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "check:deps": "node scripts/check-deps.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "check:tokens": "node scripts/gen-tokens.mjs --check && node scripts/check-tokens-design.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:types": "node scripts/gen-api-types.mjs",
    "check:types": "node scripts/gen-api-types.mjs --check",
    "lint:guards": "node scripts/lint-guards.mjs",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint": "pnpm run check:deps && pnpm run lint:guards && pnpm run lint:eslint",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "build": "pnpm --filter @lingedge/admin run build && pnpm --filter @lingedge/console run build && pnpm --filter @lingedge/setup run build",
    "build:setup": "pnpm --filter @lingedge/setup run build",
    "sync:embed": "node scripts/sync-setup-embed.mjs",
    "check:embed": "node scripts/sync-setup-embed.mjs --check",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:mock": "node scripts/check-mock.mjs",
    "test": "vitest run",
    "test:setup": "vitest run --project setup",
    "test:shared": "vitest run --project shared",
    "test:selftest": "vitest run --project scripts",
    "check": "pnpm run lint && pnpm run check:tokens && pnpm run check:contrast && pnpm run check:i18n && pnpm run check:types && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:embed && pnpm run check:isolation && pnpm run check:mock"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue": "3.5.46",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  }
}
