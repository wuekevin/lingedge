[Unit]
Description=LingEdge Server (central control plane)
{{- if .DocsHost}}
Documentation=https://{{.DocsHost}}/
{{- end}}
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User={{.User}}
Group={{.Group}}
ExecStart={{.ExecPath}} --config {{.ConfigPath}} --roles={{join .Roles ","}}
{{- if eq .Credential "systemd-credentials"}}
# 主密钥经 systemd credentials 注入，进程内通过 $CREDENTIALS_DIRECTORY/master.key 读取，文件本身仅 root 可读
LoadCredential=master.key:{{.MasterKeyPath}}
{{- else}}
# 降级（ADR-027）：本机 systemd 低于 247，不支持 LoadCredential=。主密钥改由 server.yaml 的 secrets.master_key_file 指向的文件读取，
# 该文件为 root 属主、运行组只读（0440），且不在任何备份产物中
{{- end}}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
LimitNOFILE={{.LimitNOFILE}}
# 禁止 core dump，防止主密钥/私钥明文落盘（ADR-011 §9）
LimitCORE=0

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/lingedge/server /var/log/lingedge

[Install]
WantedBy=multi-user.target
