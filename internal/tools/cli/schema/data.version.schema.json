{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "version 的 data",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools", "components"],
  "properties": {
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["version", "commit", "go", "os", "arch"],
      "properties": {"version": {"type": "string"}, "commit": {"type": "string"}, "go": {"type": "string"}, "os": {"type": "string"}, "arch": {"type": "string"}}
    },
    "components": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}}
    }
  }
}
