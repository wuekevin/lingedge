{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backup list 的 data（Story 1.41；含每个备份所需的 kek_id）",
  "type": "object",
  "additionalProperties": false,
  "required": ["dir", "backups"],
  "properties": {
    "dir": {"type": "string"},
    "backups": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "name", "size", "mtime", "encrypted", "status", "meta_authenticated"],
      "properties": {
        "path": {"type": "string"}, "name": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "mtime": {"type": "string"},
        "encrypted": {"type": "boolean"}, "status": {"enum": ["ok", "invalid"]}, "problem": {"type": "string"}, "meta_authenticated": {"type": "boolean"},
        "meta": {"type": "object", "additionalProperties": false,
          "required": ["format_version", "purpose", "component", "version", "host", "created_at", "schema_version", "deploy_lineage", "key_fingerprint", "kek_ids_required", "key_included"],
          "properties": {
            "format_version": {"type": "integer"}, "purpose": {"enum": ["manual", "pre-restore", "pre-upgrade", "pre-rollback"]}, "component": {"enum": ["server", "node"]}, "version": {"type": "string"},
            "host": {"type": "string"}, "created_at": {"type": "string"}, "schema_version": {"type": "integer"}, "deploy_lineage": {"type": ["integer", "null"]},
            "key_fingerprint": {"type": "string"}, "kek_ids_required": {"type": "array", "items": {"type": "string"}}, "key_included": {"type": "boolean"}}}
      }}}
  }
}
