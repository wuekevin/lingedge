{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backup restore 的 data（tools-design §17.5；Story 1.41）",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "component", "archive", "backup_version", "backup_host", "backup_created_at", "schema_backup", "key_check", "replace", "db_objects_before",
    "files_restored", "files_kept", "probe", "backup_lineage", "warnings", "dry_run"],
  "properties": {
    "outcome": {"enum": ["planned", "restored"]},
    "component": {"enum": ["server", "node"]},
    "archive": {"type": "string"},
    "backup_version": {"type": "string"},
    "backup_host": {"type": "string"},
    "backup_created_at": {"type": "string"},
    "schema_backup": {"type": "integer"},
    "schema_binary": {"type": "integer"},
    "key_check": {"enum": ["match", "rotated_superset", "installed_from_file", "installed_from_backup", "not_applicable"]},
    "saved_key_file": {"type": "string"},
    "safety_backup": {"type": "string"},
    "replace": {"type": "boolean"},
    "db_objects_before": {"type": "integer", "minimum": 0},
    "files_restored": {"type": "array", "items": {"type": "string"}},
    "files_kept": {"type": "array", "items": {"type": "string"}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["skipped", "probed"],
      "properties": {"skipped": {"type": "boolean"}, "reason": {"type": "string"}, "probed": {"type": ["array", "null"], "items": {"type": "string"}}}},
    "lineage_before": {"type": "integer"},
    "lineage_after": {"type": "integer"},
    "backup_lineage": {"type": ["integer", "null"]},
    "health": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
    "tx": {"type": "string"},
    "dry_run": {"type": "boolean"}
  }
}
